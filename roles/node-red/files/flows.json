    {
        "id": "aa39a450a4a0f982",
        "type": "function",
        "z": "1561679d6f0e7efe",
        "name": "sensorDepositEntrada",
        "func": "// 1. Constantes físicas de la ETAP (Geometría del depósito)\nconst ALTURA_MAX_M = 5.0;      // Altura máxima del depósito (5 metros)\nconst AREA_BASE_M2 = 100.0;    // Base de 100 m2 (5m * 100m2 = 500 m3 totales)\nconst CAUDAL_SALIDA_M3H = 450.0; // Consumo de la planta hacia filtros (m3/h)\n\n// 2. Recuperar el volumen actual de la memoria (si no existe, empezamos a mitad: 250 m3)\nlet volumenActual = context.get('volumenActual') ?? 250.0;\nlet ultimoTimestamp = context.get('ultimoTimestamp') ?? Date.now();\n\nlet ahora = Date.now();\nlet diferencialTiempoHoras = (ahora - ultimoTimestamp) / (1000 * 60 * 60); // ms a horas\ncontext.set('ultimoTimestamp', ahora);\n\n// 3. LEER EL CAUDAL REAL DEL OTRO SENSOR (Memoria global)\nlet msgCaudal = global.get('ultimoMsgCaudal') || { payload: { value: 45000 } };\nlet caudalEntradaM3H = msgCaudal.payload.value / 100;\n\n// 4. Balance de materia (Cálculo del volumen interno)\nlet volumenEntrado = caudalEntradaM3H * diferencialTiempoHoras;\nlet volumenSalido = CAUDAL_SALIDA_M3H * diferencialTiempoHoras;\nvolumenActual = volumenActual + (volumenEntrado - volumenSalido);\n\n// Límites físicos del volumen para evitar desbordes\nlet volumenMaximoPosible = ALTURA_MAX_M * AREA_BASE_M2; // 500 m3\nif (volumenActual > volumenMaximoPosible) volumenActual = volumenMaximoPosible;\nif (volumenActual < 0) volumenActual = 0;\n\ncontext.set('volumenActual', volumenActual);\n\n// 5. TRADUCCIÓN A FÍSICA REAL: Calculamos la ALTURA del agua (h = V / Área)\nlet alturaRealMetros = volumenActual / AREA_BASE_M2;\nlet valorDecimal = Number(alturaRealMetros.toFixed(2)); // Ej: 2.50 metros\n\n// 6. Multiplicamos por 100 para el entero Modbus (Ej: 2.50 -> 250)\nlet valorEnteroModbus = Math.round(valorDecimal * 100);\n\n// Configuración obligatoria para el histórico del Chart\nmsg.topic = \"Altura_Deposito_Entrada\";\nmsg.timestamp = ahora;\n\n// ESTRUCTURA ESTÁNDAR UNIFICADA\nmsg.payload = {\n    sensor: \"sensor_altura_deposito_entrada\",\n    value: valorEnteroModbus, // <--- Tu entero en msg.payload.value (Ej: 250)\n    unidad: \"m\",\n    fc: 3,\n    unitid: 1,\n    address: 104,\n    quantity: 1\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
