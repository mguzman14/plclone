    {
        "id": "275e763813031c95",
        "type": "function",
        "z": "1561679d6f0e7efe",
        "name": "sensorPresion",
        "func": "let timestamp = msg.payload;\nlet presionBase = 4.5;\nlet variacion = (Math.random() - 0.5) * 0.3;\nlet presionFinal = presionBase + variacion;\n\n// Convertimos a entero para Modbus\nlet valorModbus = Math.round(presionFinal * 100);\n\n// Configuramos el mensaje para el nodo Modbus\nmsg.payload = {\n    value: valorModbus, \n    fc: 6,              // FC 6 (Write Single Register) es perfecto para %MW\n    unitid: 1,\n    address: 100,       // Cambiado a 100 para apuntar a %MW100\n    quantity: 1\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
