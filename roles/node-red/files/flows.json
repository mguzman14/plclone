    {
        "id": "f40ad38cbf3374a8",
        "type": "function",
        "z": "1561679d6f0e7efe",
        "name": "sensorCaudal",
        "func": "let timestamp = msg.payload;\n\nlet presionBase = 4.5; // Bar\nlet variacion = (Math.random() - 0.5) * 0.3; // Variación de +/- 0.15 bar\n\nlet presionFinal = presionBase + variacion;\n\nmsg.payload = {\n    sensor: \"sensor_presion_bomba\",\n    valor: parseFloat(presionFinal.toFixed(2)),\n    unidad: \"bar\",\n    timestamp: timestamp\n};\n\nmsg.payload = msg.payload.valor;\nreturn msg;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
