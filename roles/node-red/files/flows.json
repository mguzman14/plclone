        "id": "f40ad38cbf3374a8",
        "type": "function",
        "z": "1561679d6f0e7efe",
        "name": "sensorCaudal",
        "func": "let timestamp = msg.payload; // Recibe el pulso del inject\nlet caudalBase = 450.0; // Caudal real base en m3/h\nlet variacion = (Math.random() - 0.5) * 25.0; // Variación o ruido\nlet caudalFinal = caudalBase + variacion;\n\n// Multiplicamos por 100 para obtener el entero Modbus (Ej: 45024)\nlet valorEntero = Math.round(caudalFinal * 100);\n\n// Configuración obligatoria para el histórico del Chart\nmsg.topic = \"Caudal_Entrada\";\nmsg.timestamp = Date.now(); \n\n// ESTRUCTURA ESTÁNDAR: El entero va DIRECTAMENTE en value\nmsg.payload = {\n    sensor: \"sensor_caudal_entrada\",\n    value: valorEntero, // <--- Aquí va el entero puro (45024) para el PLC y la HMI\n    unidad: \"m3/h\",\n    fc: 3,\n    unitid: 1,\n    address: 102,\n    quantity: 1\n};\n\nreturn msg;",
