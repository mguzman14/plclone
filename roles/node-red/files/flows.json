    {
        "id": "275e763813031c95",
        "type": "function",
        "z": "1561679d6f0e7efe",
        "name": "sensorPresion",
        "func": "let timestamp = msg.payload; // Recibe el pulso del inject\nlet presionBase = 4.5; // Bar\nlet variacion = (Math.random() - 0.5) * 0.3; // Variación sutil\nlet presionFinal = presionBase + variacion;\n\n// 1. Calculamos el decimal real limpio (Ej: 4.53)\nlet valorDecimal = Number(presionFinal.toFixed(2));\n\n// 2. Multiplicamos por 100 para el entero Modbus (Ej: 453)\nlet valorEntero = Math.round(valorDecimal * 100);\n\n// Configuración obligatoria para el histórico del Chart\nmsg.topic = \"Presion_Entrada\";\nmsg.timestamp = Date.now(); \n\n// 3. ESTRUCTURA UNIFICADA: Igual que en el caudal\nmsg.payload = {\n    sensor: \"sensor_presion_bomba\",\n    value: valorEntero,        // <--- El entero (453) para tu nodo Modbus toPLC\n    value_decimal: valorDecimal, // <--- El decimal (4.53) exclusivo para la HMI\n    unidad: \"bar\",\n    fc: 3,\n    unitid: 1,\n    address: 100,\n    quantity: 1\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 140,
        "wires": [
