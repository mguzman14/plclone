version: '3.9'

services:
  weavescope:
    image: weaveworks/scope:{{ scope_version | default('latest') }}
    container_name: weavescope
    network_mode: host
    pid: host
    privileged: true
    restart: always
    volumes:
      - "/run/user/1000/podman/podman.sock:/var/run/docker.sock:Z"
    #------------------------------------------------------------------------
    # "app" activa el entrypoint, "-app-listen" configura el puerto en Go
    #------------------------------------------------------------------------
    command: --probe.docker=true --probe.docker.bridge=none unix:///var/run/docker.sock